[Unit]
Description=LAKSA external e-stop bridge (Orin pin 15 -> /laksa/estop_hw)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=karsha
Group=gpio
Environment=HOME=/home/karsha
ExecStart=/bin/bash -c 'source /opt/ros/humble/setup.bash && exec python3 -u /home/karsha/estop_bridge/external_estop_bridge.py --ros-args -p run_debounce_reads:=5'
# SIGTERM makes the bridge publish a final STOP before exiting.
KillSignal=SIGTERM
TimeoutStopSec=5
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target

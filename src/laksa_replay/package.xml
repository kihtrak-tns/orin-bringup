<?xml version="1.0"?>
<package format="3">
  <name>laksa_replay</name>
  <version>0.1.0</version>
  <description>
    Replay pipeline over Phase A rosbags: bag playback launch file and a
    pure post-processing sanity check (bag_stats) for recorded evidence.
  </description>
  <maintainer email="swathisundaravarathan@gmail.com">LAKSA team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

+// HOLD TO RUN while this page is open and visible, for at most 2 minutes.
+const EXPLORE_S = 120; let exploreTimer = null, exploreEnd = 0;
+function stopExplore() { if (!exploreTimer) return; clearInterval(exploreTimer); exploreTimer = null;
+  send({cmd:'release'}); $('explore').classList.remove('on'); $('explore').textContent = 'EXPLORE (2 min, slow)'; }
+$('explore').onclick = () => {
+  if (exploreTimer) { stopExplore(); return; }
+  exploreEnd = Date.now() + EXPLORE_S * 1000; $('explore').classList.add('on'); send({cmd:'hold'});
+  exploreTimer = setInterval(() => {
+    const left = Math.ceil((exploreEnd - Date.now()) / 1000);

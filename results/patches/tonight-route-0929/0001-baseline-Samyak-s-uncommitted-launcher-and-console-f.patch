+        <dt>E-stop</dt><dd id="estop">–</dd>
+        <dt>Driver</dt><dd id="driver">–</dd>
+        <dt>Speed</dt><dd id="speed">–</dd>
+        <dt>Battery</dt><dd id="battery">–</dd>
+        <dt>Person</dt><dd id="person">–</dd>
+        <dt>Start</dt><dd id="startpt">not set</dd>
+        <dt>End</dt><dd id="goalpt">not set</dd>
+      </dl>
+    </div>
+    <div class="panel">
+      <h2>Camera (ZED)</h2>
+      <img id="camera" alt="camera">
+      <div id="dets">no detections</div>
+    </div>

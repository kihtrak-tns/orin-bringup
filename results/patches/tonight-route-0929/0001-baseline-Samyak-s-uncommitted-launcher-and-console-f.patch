+};
+$('hold').addEventListener('pointerdown', startHold);
+$('go').addEventListener('pointerdown', startGo);
+['pointerup','pointercancel','pointerleave'].forEach(t => $('go').addEventListener(t, endGo));
+$('plan').onclick = () => send({cmd:'plan'});
+['pointerup','pointercancel','pointerleave'].forEach(t => $('hold').addEventListener(t, endHold));
+document.addEventListener('visibilitychange', () => { if (document.hidden) endHold(); });
+window.addEventListener('blur', () => endHold());
+$('stop').onclick = () => { endHold(); send({cmd:'stop'}); };
+$('rearm').onclick = () => send({cmd:'rearm'});
+function setMode(m) { mode = m; ['View','Start','Goal'].forEach(k => $('mode'+k).classList.toggle('active', m === k.toLowerCase())); }
+$('modeView').onclick = () => setMode('view'); $('modeStart').onclick = () => setMode('start'); $('modeGoal').onclick = () => setMode('goal');
+$('follow').onclick = () => { follow = !follow; $('follow').textContent = 'Follow car: ' + (follow ? 'on' : 'off'); };
+$('clearTrail').onclick = () => send({cmd:'clear_trail'});
+
+// ---------- map view
+function resize() { const r = canvas.getBoundingClientRect(); canvas.width = r.width * devicePixelRatio; canvas.height = r.height * devicePixelRatio; render(); }
+window.addEventListener('resize', resize); setTimeout(resize, 0);
+const toScreen = (x, y) => [canvas.width / 2 + (x - view.cx) * view.scale, canvas.height / 2 - (y - view.cy) * view.scale];
+const toWorld = (px, py) => [view.cx + (px - canvas.width / 2) / view.scale, view.cy - (py - canvas.height / 2) / view.scale];
+canvas.addEventListener('wheel', e => { e.preventDefault(); view.scale *= e.deltaY < 0 ? 1.15 : 1 / 1.15;
+  view.scale = Math.max(5, Math.min(400, view.scale)); render(); }, { passive: false });
+let drag = null;
+canvas.addEventListener('pointerdown', e => {
+  const px = e.offsetX * devicePixelRatio, py = e.offsetY * devicePixelRatio;
+  if (mode === 'start' || mode === 'goal') { const [x, y] = toWorld(px, py); send({cmd: mode, x, y}); setMode('view'); return; }
+  drag = { px, py, cx: view.cx, cy: view.cy }; follow = false; $('follow').textContent = 'Follow car: off';
+});
+canvas.addEventListener('pointermove', e => { if (!drag) return;
+  view.cx = drag.cx - (e.offsetX * devicePixelRatio - drag.px) / view.scale;
+  view.cy = drag.cy + (e.offsetY * devicePixelRatio - drag.py) / view.scale; render(); });
+['pointerup','pointerleave'].forEach(t => canvas.addEventListener(t, () => drag = null));
+
+function vehicleToWorld(pose, x, y) { const [px, py, th] = pose, c = Math.cos(th), s = Math.sin(th); return [px + c * x - s * y, py + s * x + c * y]; }
+
+function render() {
+  ctx.fillStyle = '#0b0d11'; ctx.fillRect(0, 0, canvas.width, canvas.height);
+  if (!state) return;
+  const pose = state.pose;
+  if (follow && pose) { view.cx = pose[0]; view.cy = pose[1]; }
+  // grid (1 m)
+  ctx.strokeStyle = '#1a1e27'; ctx.lineWidth = 1;
+  const [wx0, wy1] = toWorld(0, 0), [wx1, wy0] = toWorld(canvas.width, canvas.height);
+  for (let x = Math.floor(wx0); x <= wx1; x++) { const [sx] = toScreen(x, 0); ctx.beginPath(); ctx.moveTo(sx, 0); ctx.lineTo(sx, canvas.height); ctx.stroke(); }
+  for (let y = Math.floor(wy0); y <= wy1; y++) { const [, sy] = toScreen(0, y); ctx.beginPath(); ctx.moveTo(0, sy); ctx.lineTo(canvas.width, sy); ctx.stroke(); }
+  // occupancy map
+  if (mapImg && mapInfo) {
+    const [sx, sy] = toScreen(mapInfo.origin_x, mapInfo.origin_y + mapInfo.height * mapInfo.resolution);
+    ctx.imageSmoothingEnabled = false; ctx.globalAlpha = 0.9;
+    ctx.drawImage(mapImg, sx, sy, mapInfo.width * mapInfo.resolution * view.scale, mapInfo.height * mapInfo.resolution * view.scale);
+    ctx.globalAlpha = 1;
+  }
+  // track
+  if (state.trail && state.trail.length > 1) {
+    ctx.strokeStyle = '#3a8dde'; ctx.lineWidth = 2 * devicePixelRatio; ctx.beginPath();
+    state.trail.forEach(([x, y], i) => { const [sx, sy] = toScreen(x, y); i ? ctx.lineTo(sx, sy) : ctx.moveTo(sx, sy); });
+    ctx.stroke();
+  }
+  if (pose) {
+    // LiDAR
+    ctx.fillStyle = '#e8453c';
+    (state.lidar || []).forEach(([x, y]) => { const [wx, wy] = vehicleToWorld(pose, x, y); const [sx, sy] = toScreen(wx, wy); ctx.fillRect(sx - 1.5, sy - 1.5, 3, 3); });
+    // detections
+    ctx.font = (12 * devicePixelRatio) + 'px system-ui'; ctx.lineWidth = 2 * devicePixelRatio;
+    (state.detections || []).forEach(d => {
+      const [wx, wy] = vehicleToWorld(pose, d.x, d.y); const [sx, sy] = toScreen(wx, wy);
+      const person = d.label.toLowerCase() === 'person';
+      ctx.strokeStyle = person ? '#e0a030' : '#b07ae0'; ctx.fillStyle = ctx.strokeStyle;
+      ctx.beginPath(); ctx.arc(sx, sy, 10 * devicePixelRatio, 0, 2 * Math.PI); ctx.stroke();
+      ctx.fillText(d.label + ' ' + Math.round(d.confidence) + '%', sx + 12 * devicePixelRatio, sy - 6 * devicePixelRatio);
+    });
+    // car footprint (rear axle origin: front 0.419, rear 0.149, half width 0.148)
+    const corners = [[0.419, 0.148], [0.419, -0.148], [-0.149, -0.148], [-0.149, 0.148]].map(([x, y]) => toScreen(...vehicleToWorld(pose, x, y)));
+    ctx.fillStyle = '#2fbf4f55'; ctx.strokeStyle = '#2fbf4f'; ctx.beginPath();
+    corners.forEach(([sx, sy], i) => i ? ctx.lineTo(sx, sy) : ctx.moveTo(sx, sy)); ctx.closePath(); ctx.fill(); ctx.stroke();
+    const [nx, ny] = toScreen(...vehicleToWorld(pose, 0.6, 0)), [cx, cy] = toScreen(...vehicleToWorld(pose, 0.2, 0));
+    ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(nx, ny); ctx.stroke();
+  }
+  const marker = (p, color, label) => { if (!p) return; const [sx, sy] = toScreen(p[0], p[1]);
+    ctx.fillStyle = color; ctx.beginPath(); ctx.arc(sx, sy, 7 * devicePixelRatio, 0, 2 * Math.PI); ctx.fill();
+    ctx.fillText(label, sx + 10 * devicePixelRatio, sy + 4 * devicePixelRatio); };
+  const route = (state.route || {}).path;
+  if (route && route.length > 1) {
+    ctx.strokeStyle = '#3a8dde'; ctx.lineWidth = 3 * devicePixelRatio; ctx.beginPath();
+    route.forEach(([x, y], i) => { const [sx, sy] = toScreen(x, y); i ? ctx.lineTo(sx, sy) : ctx.moveTo(sx, sy); });
+    ctx.stroke();
+  }
+  marker(state.start, '#2fbf4f', 'START'); marker(state.goal, '#d33a3a', 'END');
+  $('mapnote').textContent = (mapInfo ? `map ${mapInfo.width}×${mapInfo.height} @ ${mapInfo.resolution} m` : 'no map yet (mapping not running)')
+    + ` · pose frame: ${state.status.pose_frame || '–'} · scroll to zoom, drag to pan`;
+}
+
+function cls(el, c) { el.className = c; }
+function updateStatus() {
+  const s = state.status;
+  $('mission').textContent = s.mission; cls($('mission'), ['LIDAR_CRUISE', 'NAVIGATING'].includes(s.mission) ? 'ok' : (s.mission === 'EMERGENCY_STOP' ? 'bad' : ''));
+  const r = state.route || {};
+  const routeText = {IDLE: 'Set END on the map, then PLAN ROUTE.', PLANNING: 'planning…',
+    PLANNED: `route ${r.length_m} m — hold GO to drive it`, NAVIGATING: 'driving the route — release GO to stop',
+    ARRIVED: 'arrived at END', STOPPED: 'stopped' + (r.detail ? ': ' + r.detail : ''),
+    FAILED: 'no route' + (r.detail ? ': ' + r.detail : '')};
+  $('routeinfo').textContent = routeText[r.state] || r.state || '';
+  cls($('routeinfo'), r.state === 'FAILED' ? 'bad' : (r.state === 'ARRIVED' || r.state === 'PLANNED' ? 'ok' : ''));
+  $('health').textContent = s.health; cls($('health'), s.health === 'READY' ? 'ok' : 'warn');
+  $('estop').textContent = s.estop === null ? '–' : (s.estop ? 'LATCHED ' + (s.estop_reason || '') : 'clear'); cls($('estop'), s.estop ? 'bad' : 'ok');
+  $('driver').textContent = s.driver + (state.holding ? ' · holding' : '');
+  $('speed').textContent = s.speed_mps === null ? '–' : s.speed_mps.toFixed(2) + ' m/s';
+  $('battery').textContent = s.battery_v === null ? '–' : s.battery_v.toFixed(1) + ' V' + (s.vesc_fault ? ' · VESC fault ' + s.vesc_fault : '');
+  const p = s.person || {};
+  $('person').textContent = p.nearest_m == null ? 'none ahead' : (p.stop ? 'STOP ' : (p.factor < 1 ? 'slow ' : '')) + p.nearest_m.toFixed(2) + ' m';
+  $('startpt').textContent = state.start ? state.start.map(v => v.toFixed(2)).join(', ') : 'not set';
+  $('goalpt').textContent = state.goal ? state.goal.map(v => v.toFixed(2)).join(', ') : 'not set';
+  const d = state.detections || [];
+  $('dets').textContent = d.length ? d.map(x => `${x.label} ${Math.round(x.confidence)}% @ ${Math.hypot(x.x, x.y).toFixed(1)} m`).join(' · ') : 'no detections';
+}
+setInterval(() => { $('camera').src = 'camera.jpg?token=' + encodeURIComponent(token) + '&t=' + Date.now(); }, 700);
+</script>
+</body>
+</html>

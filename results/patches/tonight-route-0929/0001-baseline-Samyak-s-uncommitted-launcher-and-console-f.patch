+  };
+}
+connect();
+const send = o => { if (ws && ws.readyState === 1) ws.send(JSON.stringify(o)); };
+
+// ---------- controls
+let holdTimer = null;
+function startHold(e) { e.preventDefault(); $('hold').classList.add('on'); send({cmd:'hold'});
+  clearInterval(holdTimer); holdTimer = setInterval(() => send({cmd:'hold'}), 50); }
+function endHold(e) { if (e) e.preventDefault(); $('hold').classList.remove('on'); stopExplore(); endGo();
+  if (holdTimer) { clearInterval(holdTimer); holdTimer = null; send({cmd:'release'}); } }

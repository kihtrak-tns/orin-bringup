+  </section>
+  <aside>
+    <div class="panel">
+      <h2>Drive (learned driver)</h2>
+      <button id="hold">HOLD TO RUN</button>
+      <button id="explore">EXPLORE (2 min, slow)</button>
+      <div class="row"><button id="stop">STOP</button><button id="rearm">REARM</button></div>
+    </div>
+    <div class="panel">
+      <h2>Route to END (Nav2)</h2>
